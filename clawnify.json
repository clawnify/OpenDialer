{
  "$schema": "https://app.clawnify.com/schema/v1/clawnify.json",
  "version": 1,
  "name": "Phone",
  "description": "Phone system for sales and support teams on your own Twilio account. Inbound numbers with business hours and a press-a-digit menu ring a team in the browser, first answer wins; warm and blind transfers, voicemail and a shared inbox for missed calls. Plus an outbound dialer with local caller ID for lead lists.",
  "icon": "icon.svg",
  "tags": [
    "phone-system",
    "calling",
    "call-center",
    "dialer",
    "twilio",
    "support",
    "sales"
  ],
  "app": {
    "framework": "react+hono",
    "database": true,
    "storage": false
  },
  "api": {
    "public_routes": [
      {
        "path": "/api/twilio/*",
        "methods": [
          "POST"
        ]
      }
    ]
  },
  "env": {
    "required": [
      "TWILIO_ACCOUNT_SID",
      "TWILIO_AUTH_TOKEN"
    ],
    "optional": [
      "TWILIO_FROM_NUMBER",
      "TWILIO_TWIML_APP_SID",
      "TWILIO_API_KEY_SID",
      "TWILIO_API_KEY_SECRET",
      "PUBLIC_APP_URL",
      "TWILIO_REGION"
    ]
  },
  "deploy": {
    "subtitle": "A browser phone system for your team, on your own Twilio account.",
    "prompts": [
      {
        "key": "company_name",
        "label": "Company name",
        "placeholder": "Acme GmbH",
        "type": "text"
      },
      {
        "key": "primary_market",
        "label": "Primary market",
        "type": "select",
        "options": [
          "US",
          "Europe",
          "Both"
        ]
      }
    ]
  },
  "agent": "agent.md"
}
